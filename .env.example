# Kopieer naar .env (lokaal) of zet deze in Railway > Variables

# Verplicht
ANTHROPIC_API_KEY=sk-ant-...
SECRET_KEY=lange-willekeurige-tekst

# Alleen nodig als je ook het webdashboard gebruikt (Generate Domain)
APP_PASSWORD=kies-een-sterk-wachtwoord

# Automatisch op Railway als je een Postgres-database toevoegt
# DATABASE_URL=postgresql://...

# Telegram (aanrader)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLEEN_WIJZIGINGEN=true

# Optioneel: wanneer de agents automatisch draaien (werkdagen)
ANALYSE_TIJDEN=09:30,17:45
TIJDZONE=Europe/Amsterdam

# Optioneel: modellen per agent
MODEL_NIEUWS=claude-haiku-5-5
MODEL_ANALIST=claude-sonnet-5-5
MODEL_RISICO=claude-sonnet-5-5
